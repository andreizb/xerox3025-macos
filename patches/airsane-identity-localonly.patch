+// SPDX-License-Identifier: GPL-3.0-or-later
+// WorkCentre 3025 flatbed acquisition and lossless raster crop helpers.
+#ifndef XEROX_CROP_H
+#define XEROX_CROP_H
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+#include <limits>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace xeroxcrop {
+
+inline bool applies(const std::string& saneName, const std::string& model,
+                    bool platen, bool hasAdf)
+{
+  return platen && !hasAdf && saneName.compare(0, 10, "xerox_mfp:") == 0 &&
+         model == "Xerox WorkCentre 3025";
+}
+
+inline int pixelCount(double value)
+{
+  // eSCL dimensions may be fractional pixels at resolutions below 300 dpi.
+  // Keep only complete requested pixels; never invent an extra boundary pixel.
+  if (!std::isfinite(value) || value < 1 ||
+      value > std::numeric_limits<int>::max())
+    throw std::runtime_error("invalid crop pixel count");
+  return static_cast<int>(std::floor(value + 1e-9));
+}
+
+inline double fixedMm(double value)
+{
+  // SANE_TYPE_FIXED uses signed 16.16, truncated by SANE_FIX.
+  return std::floor(value * 65536.0) / 65536.0;
+}
+
+inline double encodedOriginMm(double acceptedMm)
+{
+  // xerox_mfp dev_set_window writes an inch byte and a hundredths byte.
+  // Reproduce its truncation, including floating-point boundary behavior.
+  const double inches = acceptedMm / 25.4;
+  const double whole = std::floor(inches);
+  return (whole + std::floor((inches - whole) * 100.0) / 100.0) * 25.4;
+}
+
+inline int backendPixels(double extentMm, int dpi)
+{
+  if (!std::isfinite(extentMm) || extentMm <= 0 || dpi <= 0)
+    throw std::runtime_error("invalid backend extent");
+  // The patched model uses integer 1200-point windows, then truncates again
+  // to the selected output resolution in set_parameters().
+  return static_cast<int>(std::floor(std::floor(extentMm * (1200.0 / 25.4)) /
+                                     (1200.0 / dpi)));
+}
+
+struct Axis
+{
+  double beginMm = 0, endMm = 0;
+};
+
+inline Axis acquisitionAxis(double startPx, double sizePx, int dpi,
+                            double bedBeginMm, double bedEndMm)
+{
+  if (!std::isfinite(startPx) || startPx < 0 || dpi <= 0 ||
+      !std::isfinite(bedBeginMm) || !std::isfinite(bedEndMm) ||
+      bedBeginMm != 0 || bedEndMm <= bedBeginMm)
+    throw std::runtime_error("invalid acquisition bounds");
+  pixelCount(sizePx);
+  const double begin = startPx * 25.4 / dpi;
+  const double end = (startPx + sizePx) * 25.4 / dpi;
+  if (!std::isfinite(end) || begin < bedBeginMm || end > bedEndMm + 1e-7)
+    throw std::runtime_error("crop exceeds flatbed bounds");
+
+  // The device erases approximately 2 mm around every requested window.
+  // Acquire 3 mm more, on the device's 0.01-inch origin grid. A small positive
+  // offset survives SANE's fixed-point conversion without falling into the
+  // previous hundredth-inch bucket. Read-back remains authoritative.
+  const double grid = 0.254, margin = 3.0;
+  Axis axis;
+  axis.beginMm = std::max(bedBeginMm,
+      std::floor((begin - margin) / grid) * grid + 0.0001);
+  axis.endMm = std::min(bedEndMm, std::ceil((end + margin) / grid) * grid);
+  return axis;
+}
+
+struct Raster
+{
+  int left = 0, top = 0, width = 0, height = 0;
+
+  bool containsRow(int row) const
+  { return row >= top && row - top < height; }
+};
+
+inline Raster raster(double leftPx, double topPx, double widthPx,
+                     double heightPx, int dpi, double acceptedLeftMm,
+                     double acceptedTopMm, int acquiredWidth,
+                     int acquiredHeight)
+{
+  if (!std::isfinite(leftPx) || !std::isfinite(topPx) || dpi <= 0 ||
+      !std::isfinite(acceptedLeftMm) || !std::isfinite(acceptedTopMm))
+    throw std::runtime_error("invalid raster crop origin");
+  Raster result;
+  const double left = leftPx - encodedOriginMm(acceptedLeftMm) * dpi / 25.4;
+  const double top = topPx - encodedOriginMm(acceptedTopMm) * dpi / 25.4;
+  if (left < -1e-7 || top < -1e-7 ||
+      left > std::numeric_limits<int>::max() ||
+      top > std::numeric_limits<int>::max())
+    throw std::runtime_error("acquisition does not contain crop origin");
+  result.left = static_cast<int>(std::floor(std::max(0.0, left) + 1e-7));
+  result.top = static_cast<int>(std::floor(std::max(0.0, top) + 1e-7));
+  result.width = pixelCount(widthPx);
+  result.height = pixelCount(heightPx);
+  if (result.left > acquiredWidth || result.width > acquiredWidth - result.left ||
+      result.top > acquiredHeight || result.height > acquiredHeight - result.top)
+    throw std::runtime_error("acquired raster does not contain requested crop");
+  return result;
+}
+
+inline void cropRow(const std::vector<char>& source, int sourceWidth,
+                    int left, int width, int components, int depth,
+                    std::vector<char>& destination)
+{
+  if (sourceWidth <= 0 || left < 0 || width <= 0 || left > sourceWidth ||
+      width > sourceWidth - left || (components != 1 && components != 3) ||
+      (depth != 1 && depth != 8 && depth != 16) ||
+      (depth == 1 && components != 1))
+    throw std::runtime_error("invalid raster row crop");
+  const size_t bitsPerPixel = components * depth;
+  const size_t inputBytes = (size_t(sourceWidth) * bitsPerPixel + 7) / 8;
+  const size_t outputBytes = (size_t(width) * bitsPerPixel + 7) / 8;
+  if (source.size() < inputBytes || &source == &destination)
+    throw std::runtime_error("truncated or aliased raster row");
+  destination.resize(outputBytes);
+  if (depth != 1) {
+    std::memcpy(destination.data(), source.data() + size_t(left) * bitsPerPixel / 8,
+                outputBytes);
+    return;
+  }
+  // SANE and PNG both store the leftmost pixel in the high bit. Polarity has
+  // already been converted by applyGamma; copy bits without interpreting them.
+  // Unused final-byte bits are white (1) and are outside the declared width.
+  std::fill(destination.begin(), destination.end(), static_cast<char>(0xff));
+  for (int x = 0; x < width; ++x) {
+    const unsigned pixel = static_cast<unsigned char>(source[(left + x) / 8]) &
+                           (0x80u >> ((left + x) % 8));
+    if (!pixel)
+      destination[x / 8] = static_cast<char>(
+          static_cast<unsigned char>(destination[x / 8]) & ~(0x80u >> (x % 8)));
+  }
+}
+
+} // namespace xeroxcrop
+#endif
