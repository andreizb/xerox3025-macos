#!/bin/bash
# SPDX-License-Identifier: MIT
# Installer maintenance only; never used by the background scanner service.
set -eu
python_explicit="${1:-}"
python_saved="${2:-}"
python_valid() {
  [[ "$1" == /* && -x "$1" ]] && "$1" -I -c 'import platform,sys; sys.exit(0 if sys.version_info >= (3,9) and platform.machine() == "arm64" else 1)' >/dev/null 2>&1
}
if [[ -n "$python_explicit" ]]; then
  if python_valid "$python_explicit"; then printf '%s\n' "$python_explicit"; exit 0; fi
else
  if [[ -n "$python_saved" ]] && python_valid "$python_saved"; then printf '%s\n' "$python_saved"; exit 0; fi
  python_found="$(command -v python3 || true)"
  if [[ -n "$python_found" ]] && python_valid "$python_found"; then printf '%s\n' "$python_found"; exit 0; fi
fi
printf 'Association installation/removal requires a native ARM64 Python 3.9+ interpreter. Use --python /absolute/path/to/python3. No files or settings have been removed.\n' >&2
exit 69
